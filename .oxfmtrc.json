{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // Matches the width the codebase was previously formatted at with Prettier.
  // Oxfmt's own default is 100.
  "printWidth": 80,

  // Replaces prettier-plugin-jsdoc.
  "jsdoc": true,

  // Replaces @ianvs/prettier-plugin-sort-imports. Mirrors the default group
  // order of eslint-plugin-perfectionist, which Oxfmt's sorter is based on.
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },

  // Replaces prettier-plugin-tailwindcss.
  "sortTailwindcss": {
    "stylesheet": "./src/styles/tailwind.css",
    "functions": ["tw"]
  },

  // Everything else is read from .gitignore. These two are tracked but
  // generated (`wrangler types` / `astro sync`), so they are not ours to format.
  "ignorePatterns": ["worker-configuration.d.ts", "src/env.d.ts"]
}
