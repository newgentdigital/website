---
export const prerender = true;

import AttributionsList from "@/components/legal/AttributionsList.astro";
import SectionWrapperVertical from "@/components/sections/SectionWrapperVertical.astro";
import LayoutNewgent from "@/layouts/LayoutNewgent.astro";
---

<LayoutNewgent>
  <slot name="content">
    <SectionWrapperVertical>
      <h1 class="h3" slot="header">Newgent loves open-source</h1>
      <p class="p" slot="content">
        We love open-source software and the communities that build it. That's
        why we want to dedicate this page to giving credit where credit is due.
        We use <span class="italic">a lot</span> of open-source software in our projects,
        and we want to make sure those projects get the recognition they deserve.
      </p>
    </SectionWrapperVertical>

    <AttributionsList />
  </slot>
</LayoutNewgent>
