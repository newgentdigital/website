---
export const prerender = true;

import AttributionsList from "@/components/legal/AttributionsList.astro";
import SectionWrapperVertical from "@/components/sections/SectionWrapperVertical.astro";
import LayoutFinconnect from "@/layouts/LayoutFinconnect.astro";
---

<LayoutFinconnect>
  <slot name="content">
    <SectionWrapperVertical>
      <h1 class="h3" slot="header">Finconnect stands on open source</h1>
      <p class="p" slot="content">
        Behind every success lies community. We are proud to build on open
        source and want, on this page, to highlight the projects that make it
        possible. Our use of open source is fundamental to Finconnect's success
        and growth.
      </p>
    </SectionWrapperVertical>

    <AttributionsList scope="finconnect" />
  </slot>
</LayoutFinconnect>
