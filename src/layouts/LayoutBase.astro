---
import { Font } from "astro:assets";
import "../styles/tailwind.css";
---

<html class="scroll-smooth scrollbar-gutter-stable" lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument-serif" />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-anek-latin" preload />

    <script>
      (function () {
        const isDark =
          localStorage.theme === "dark" ||
          (!localStorage.theme &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        localStorage.theme = isDark ? "dark" : "light";
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.classList.toggle("cc--darkmode", isDark);
      })();
    </script>

    <script
      defer
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

    <slot name="head" />
  </head>

  <body
    class="bg-zinc-100 selection:bg-nwg-sky-500 selection:text-zinc-50 dark:bg-zinc-900"
  >
    <slot name="navbar" />

    <div
      class="mx-2 max-w-5xl border-x border-dashed border-zinc-300 sm:mx-auto dark:border-zinc-700"
    >
      <slot name="body" />
    </div>

    <slot name="footer" />
  </body>
</html>

<script>
  import "@orestbida/iframemanager";
  import "@orestbida/iframemanager/dist/iframemanager.css";

  window.addEventListener("load", function () {
    // @ts-expect-error Can't find name 'iframemanager', but it's loaded above
    const im = iframemanager();

    im.run({
      currLang: document.documentElement.lang,

      services: {
        youtube: {
          embedUrl: "https://www.youtube-nocookie.com/embed/{data-id}",
          thumbnailUrl: "https://i3.ytimg.com/vi/{data-id}/hqdefault.jpg",
          iframe: {
            allow:
              "accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen;",
          },

          languages: {
            en: {
              notice:
                'This content is hosted by YouTube. By showing the content you accept the <a rel="noreferrer noopener" href="https://www.youtube.com/t/terms" target="_blank">terms and conditions</a> of youtube.com.',
              loadBtn: "Load video",
              loadAllBtn: "Don't ask again",
            },
            sv: {
              notice:
                'Detta innehåll finns hos YouTube. Genom att visa det innehållet godkänner du <a rel="noreferrer noopener" href="https://www.youtube.com/t/terms" target="_blank">youtube.com:s villkor</a>.',
              loadBtn: "Ladda video",
              loadAllBtn: "Fråga inte igen",
            },
          },
        },
      },
    });
  });
</script>
