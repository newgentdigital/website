---
import SvgLogomarkDiscernWhite from "@/assets/brand/logomark-discern-white.svg";
import NavbarBase from "./NavbarBase.astro";
import NavbarReturn from "./NavbarReturn.astro";
import { getLangFromUrl, useTranslation } from "@/i18n/utils";
import NavbarActionsBar from "./NavbarActionsBar.astro";
import SimpleIconsMetabase from "@/components/icons/simple-icons/SimpleIconsMetabase.astro";
import SimpleIconsGrafana from "@/components/icons/simple-icons/SimpleIconsGrafana.astro";
import SimpleIconsClickhouse from "@/components/icons/simple-icons/SimpleIconsClickhouse.astro";
import SimpleIconsInfluxdb from "@/components/icons/simple-icons/SimpleIconsInfluxdb.astro";
import SimpleIconsPostgresql from "@/components/icons/simple-icons/SimpleIconsPostgresql.astro";
import SimpleIconsZapier from "@/components/icons/simple-icons/SimpleIconsZapier.astro";
import SimpleIconsN8N from "@/components/icons/simple-icons/SimpleIconsN8n.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslation(lang);

const links = [
  {
    href: "/discern/destinations",
    title: t("nav").links.dataAndDashboards,
    megaMenu: {
      columns: [
        {
          title: t("nav").links.dashboards,
          items: [
            {
              title: "Grafana",
              href: "/discern/destinations/grafana",
              description:
                t("nav").megaMenu.discern.integrations.grafanaDescription,
              icon: SimpleIconsGrafana,
              iconClass: "text-[#F46800]",
            },
            {
              title: "Metabase",
              href: "/discern/destinations/metabase",
              description:
                t("nav").megaMenu.discern.integrations.metabaseDescription,
              icon: SimpleIconsMetabase,
              iconClass: "text-[#509EE3]",
            },
            {
              title: "Zapier",
              href: "/discern/destinations/zapier",
              description:
                t("nav").megaMenu.discern.automation.zapierDescription,
              icon: SimpleIconsZapier,
              iconClass: "text-[#FF4F00]",
            },
            {
              title: "n8n",
              href: "/discern/destinations/n8n",
              description: t("nav").megaMenu.discern.automation.n8nDescription,
              icon: SimpleIconsN8N,
              iconClass: "text-[#EA4B71]",
            },
          ],
        },
        {
          title: t("nav").links.dataPipelines,
          items: [
            {
              title: "ClickHouse",
              href: "/discern/destinations/clickhouse",
              description:
                t("nav").megaMenu.discern.destinations.clickhouseDescription,
              icon: SimpleIconsClickhouse,
              iconClass: "text-[#FFCC01]",
            },
            {
              title: "PostgreSQL",
              href: "/discern/destinations/postgresql",
              description:
                t("nav").megaMenu.discern.destinations.postgresqlDescription,
              icon: SimpleIconsPostgresql,
              iconClass: "text-[#4169E1] dark:text-[#B3C3F3]",
            },
            {
              title: "InfluxDB",
              href: "/discern/destinations/influxdb",
              description:
                t("nav").megaMenu.discern.destinations.influxdbDescription,
              icon: SimpleIconsInfluxdb,
              iconClass: "text-[#22ADF6]",
            },
          ],
        },
      ],
      featured: {
        title: t("nav").megaMenu.discern.featuredItem.title,
        description: t("nav").megaMenu.discern.featuredItem.description,
        href: "/blog",
        image:
          "https://images.unsplash.com/photo-1608222351212-18fe0ec7b13b?q=75&w=900",
        ctaText: t("nav").megaMenu.discern.featuredItem.ctaLabel,
      },
    },
  },
  { href: "/discern/setup", title: t("nav").links.setup },
  { href: "/discern/about", title: t("nav").links.about },
  { href: "/wiki", title: t("common").strings.s_f32d5a3b, alternate: true },
  { href: "/discern/pricing", title: t("nav").links.getStarted, cta: true },
];

const actionBarLinks = [
  {
    href: "https://discern.newgent.digital",
    title:
      t("nav").actionbar.platforms.items.discern.subItems.manageDiscern.label,
    description:
      t("nav").actionbar.platforms.items.discern.subItems.manageDiscern
        .description,
    isSecure: true,
  },
  {
    href: "https://billing.newgent.digital/",
    title: t("nav").actionbar.platforms.items.customerPortal.label,
    description: t("nav").actionbar.platforms.items.customerPortal.description,
    isSecure: true,
  },
  {
    href: "https://github.com/newgentdigital/discern",
    title:
      t("nav").actionbar.platforms.items.discern.subItems.discernGithub.label,
    description:
      t("nav").actionbar.platforms.items.discern.subItems.discernGithub
        .description,
  },
  {
    href: "/",
    title: t("nav").actionbar.platforms.items.newgent.label,
    description: t("nav").actionbar.platforms.items.newgent.description,
  },
];
---

<NavbarBase iconHref="/discern" {links}>
  <NavbarReturn slot="return" />
  <NavbarActionsBar
    links={actionBarLinks}
    platformsLabel={t("nav").actionbar.login}
    slot="actions"
  />

  <slot slot="icon">
    <SvgLogomarkDiscernWhite height={24} />
  </slot>
</NavbarBase>
