---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl } from "@/i18n/utils";
import RiArrowRightLine from "@/components/icons/ri/RiArrowRightLine.astro";
import { Image } from "astro:assets";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export interface MegaMenuItem {
  title: string;
  description?: string;
  href: string;
  /** An .astro icon component, rendered as `<item.icon />`. */
  icon?: AstroComponentFactory;
  iconDark?: AstroComponentFactory;
  iconClass?: string;
}

export interface MegaMenuColumn {
  title?: string;
  items: MegaMenuItem[];
}

export interface MegaMenuFeatured {
  title: string;
  description: string;
  href: string;
  image?: string;
  ctaText?: string;
}

export interface MegaMenu {
  columns: MegaMenuColumn[];
  featured?: MegaMenuFeatured;
}

interface Props {
  megaMenu: MegaMenu;
}

const { megaMenu } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div
  class="absolute top-full left-0 z-20 max-h-[calc(100vh-4rem)] w-full overflow-y-auto border-y border-zinc-300 bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900"
>
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 lg:grid-cols-12">
    <div
      class={`grid gap-8 p-8 ${megaMenu.featured ? "lg:col-span-8 lg:grid-cols-2" : "lg:col-span-12 lg:grid-cols-3"}`}
    >
      {
        megaMenu.columns.map((column) => (
          <div class="divide-y divide-zinc-200 dark:divide-zinc-700">
            {column.title && (
              <h3 class="mb-4 pb-2 text-xs font-semibold tracking-widest text-zinc-900 dark:text-zinc-100">
                {column.title.toUpperCase()}
              </h3>
            )}
            <ul class="space-y-4">
              {column.items.map((item) => {
                const isExternal = item.href.startsWith("http");
                return (
                  <li>
                    <a
                      class="flex items-start gap-3 p-2 transition hover:bg-zinc-200/50 active:opacity-70 dark:hover:bg-zinc-800"
                      href={
                        isExternal
                          ? item.href
                          : getRelativeLocaleUrl(lang, item.href)
                      }
                      {...(isExternal && {
                        rel: "noopener noreferrer",
                        target: "_blank",
                      })}
                    >
                      {item.icon && (
                        <div
                          class:list={[
                            item.iconClass
                              ? item.iconClass
                              : "text-nwg-sky-600 dark:text-nwg-sky-400",
                          ]}
                        >
                          <item.icon
                            class="mt-1 h-5 w-5"
                            class:list={[
                              item.iconDark ? "block dark:hidden" : "",
                            ]}
                          />
                          {item.iconDark && (
                            <item.iconDark class="mt-1 hidden h-5 w-5 dark:block" />
                          )}
                        </div>
                      )}
                      <div>
                        <div class="font-medium text-zinc-900 dark:text-zinc-100">
                          {item.title}
                        </div>
                        {item.description && (
                          <p class="p mt-1 text-sm leading-normal font-normal text-zinc-500">
                            {item.description}
                          </p>
                        )}
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    {
      megaMenu.featured && (
        <aside class="lg:col-span-4">
          <div class="flex h-full flex-col justify-between bg-nwg-sky-500 p-6">
            <div>
              {megaMenu.featured.image && (
                <Image
                  class="mb-4 max-h-42 w-full object-cover select-none"
                  alt=""
                  format="webp"
                  height={168}
                  src={megaMenu.featured.image}
                  width={400}
                />
              )}
              <h3 class="h3 mb-1 font-serif text-lg font-normal tracking-normal text-zinc-100">
                {megaMenu.featured.title}
              </h3>
              <p class="p mb-4 text-sm leading-normal font-normal text-zinc-100">
                {megaMenu.featured.description}
              </p>
            </div>

            <a
              class="link link-ghost flex w-fit items-center gap-1 text-zinc-100 transition-none"
              href={getRelativeLocaleUrl(lang, megaMenu.featured.href)}
            >
              {megaMenu.featured.ctaText || "Learn more"}
              <RiArrowRightLine class="h-4 w-4" />
            </a>
          </div>
        </aside>
      )
    }
  </div>
</div>
