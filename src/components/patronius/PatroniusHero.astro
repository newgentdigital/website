---
import ShaderCanvas from "@/components/shaders/ShaderCanvas.astro";
import { getLangFromUrl, useTranslation } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslation(lang);
---

<section class="relative h-125 overflow-hidden">
  <ShaderCanvas
    class="absolute inset-0 -z-50 dark:hidden"
    shader="godRays"
    params={{
      bloom: 0.1,
      colorBack: "#ffffff",
      colorBloom: "#5865F2",
      colors: ["#5865F2", "#7289DA", "#99AAB5", "#ffffff"],
      density: 0.5,
      intensity: 1,
      midIntensity: 0.5,
      midSize: 0.25,
      offsetY: -0.55,
      speed: 0.5,
      spotty: 1,
    }}
  />
  <ShaderCanvas
    class="absolute inset-0 -z-50 hidden dark:block"
    shader="godRays"
    params={{
      bloom: 0.5,
      colorBack: "#23272A",
      colorBloom: "#5865F2",
      colors: ["#5865F2", "#7289DA", "#99AAB5", "#ffffff"],
      density: 0.5,
      intensity: 1,
      midIntensity: 0.5,
      midSize: 0.25,
      offsetY: -0.55,
      speed: 0.5,
      spotty: 1,
    }}
  />

  <header class="absolute bottom-0 left-0 flex flex-col gap-4 p-8 sm:p-12">
    <span
      class="input-label-wide font-display font-semibold text-zinc-900 dark:text-zinc-100"
    >
      {t("home").patronius.hero.label}
    </span>
    <h1 class="h1">
      {t("home").patronius.hero.heading}
    </h1>
  </header>

  <div
    class="absolute right-0 bottom-0 left-0 -z-40 h-full bg-linear-to-t from-zinc-100 to-transparent dark:from-zinc-950"
    aria-hidden="true"
  >
  </div>
</section>
